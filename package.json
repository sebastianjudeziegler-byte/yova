{
  "name": "yova",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-readiness.mjs --deployment",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "YOVA_E2E_PASSWORD_AUTH=1 playwright test e2e/public-auth.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "eval:plans": "node scripts/run-plan-evaluations.mjs",
    "eval:sessions": "node scripts/run-session-evaluations.mjs",
    "eval:journeys": "node scripts/run-journey-evaluations.mjs",
    "eval:answers": "node scripts/run-answer-evaluations.mjs",
    "readiness": "node scripts/check-readiness.mjs",
    "readiness:configuration": "node scripts/check-readiness.mjs --production --configuration-only",
    "readiness:production": "node scripts/check-readiness.mjs --production",
    "smoke:production": "node scripts/smoke-deployment.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "latest",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/sora": "latest",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "katex": "0.16.47",
    "lucide-react": "latest",
    "next": "latest",
    "openai": "^7.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "16.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "latest",
    "supabase": "^2.111.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
