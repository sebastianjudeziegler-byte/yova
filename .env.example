# These values come from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after the Supabase email template includes its 6-digit token.
AUTH_EMAIL_CODE_VERIFICATION=false

# Private-alpha access. Enable only after Supabase signups are disabled and
# tester accounts are created through the founder invitation flow.
AUTH_INVITE_ONLY=false

# Public password accounts. Keep false until signup/recovery templates,
# Turnstile, and Supabase's password policy are configured and tested.
AUTH_PASSWORD_ACCOUNTS=false
AUTH_CAPTCHA_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase secret used to mint exact plan-activation permits,
# founder-approved invitations, and validated public lead-capture routes.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# At least 32 random characters. Vercel sends this Bearer value to the private
# cleanup route that removes expired account-export artifacts.
CRON_SECRET=

# Server-only HMAC key for authenticating generated plan drafts before they
# can be activated. Use at least 32 random characters. During a key rotation,
# keep the immediately previous key for no longer than the one-hour draft TTL.
# Production readiness also uses the service key above to call the read-only
# signed_in_generation_readiness_v2 database capability probe.
YOVA_DRAFT_RECEIPT_SECRET=
YOVA_DRAFT_RECEIPT_PREVIOUS_SECRET=

# Public origin used for canonical links and social sharing metadata.
# Vercel supplies its own deployment URL automatically when this is omitted.
SITE_URL=http://localhost:3000

# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_PLAN_MODEL=gpt-5.6-sol
# Optional. Sessions default to the faster gpt-5.4-mini model.
# Tutor responses default to OPENAI_PLAN_MODEL.
OPENAI_SESSION_MODEL=
OPENAI_TUTOR_MODEL=
OPENAI_LESSON_MODEL=

# Server-only staged issuance for the new evidence-personalized StudyRoute.
# Production release readiness requires an explicit value. 0 keeps new routes
# on the task-and-mastery baseline; 100 enables all new routes. Existing
# versioned routes keep their original policy after changes.
YOVA_PERSONALIZATION_ROLLOUT_PERCENT=0

# Transactional Study Profile report and waitlist confirmation email. Reports
# still render locally if these are absent, but email is not sent and a pending
# waitlist request cannot be confirmed. Do not use these settings for marketing
# campaigns until unsubscribe plus bounce and complaint suppression is in place.
RESEND_API_KEY=
STUDY_PROFILE_FROM_EMAIL="YOVA <reports@updates.yovaapp.com>"
# Optional monitored reply-to address.
STUDY_PROFILE_REPLY_TO=
